{
  "name": "relayer",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec node --import tsx src/server.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "docker:build": "docker build -t consonant-relayer:latest .",
    "docker:run": "docker run --rm -it consonant-relayer:latest"
  },
  "keywords": [
    "kubernetes",
    "telemetry",
    "opentelemetry",
    "socket.io",
    "infrastructure"
  ],
  "author": "Consonant Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@grpc/grpc-js": "^1.12.4",
    "@grpc/proto-loader": "^0.7.13",
    "@kubernetes/client-node": "^0.22.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.54.0",
    "@opentelemetry/otlp-transformer": "^0.54.0",
    "@opentelemetry/proto": "^1.0.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-trace-node": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "socket.io-client": "^4.8.1",
    "undici": "^6.21.0",
    "async-retry": "^1.3.3",
    "p-queue": "^8.0.1"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.8",
    "@types/node": "^22.9.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}