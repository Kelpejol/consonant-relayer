{
  "name": "@consonant/relayer",
"version": "0.1.0-alpha.1",
  "description": "Consonant Relayer - Cluster-resident agent for bidirectional gRPC streaming", 
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec node --import tsx src/server.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "docker:build": "docker build -t consonant-relayer:latest .",
    "docker:run": "docker run --rm -it consonant-relayer:latest"
  },
  "keywords": [
    "consonant",
    "relayer",
    "kubernetes",
    "agent",
    "kagent",
    "opentelemetry",
    "otlp",
    "cloudflare-tunnel",
    "socket.io"
  ],
  "author": "Consonant Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@consonant/proto-relayer": "^0.1.0-alpha.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@kubernetes/client-node": "^1.4.0",
    "fastify": "^5.6.2",
    "p-queue": "^9.0.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "undici": "^7.16.0",
    "zod": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
